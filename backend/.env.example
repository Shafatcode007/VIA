# NECESSITY: Example environment variables for the backend
# LOGIC: Documents all required environment variables
# EDGE-CASE: Copy this to .env and fill in actual values

# Application
APP_NAME="VIA - Multi-Service Platform"
APP_VERSION="1.0.0"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/via_db

# JWT Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
